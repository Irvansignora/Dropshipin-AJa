# ============================================================
# Paste variabel ini satu-persatu di Railway Dashboard
# Settings → Variables → Add Variable
# ============================================================

# Auto-diisi Railway jika pakai plugin PostgreSQL & Redis:
# DATABASE_URL   → otomatis dari Railway PostgreSQL plugin
# REDIS_URL      → otomatis dari Railway Redis plugin
# PORT           → otomatis dari Railway (jangan diisi manual)

# ── Wajib diisi manual ──────────────────────────────────────
NODE_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here

# ── Opsional (tanpa ini pakai mock data) ───────────────────
TIKTOK_RAPIDAPI_KEY=
INSTAGRAM_RAPIDAPI_KEY=
YOUTUBE_API_KEY=
PINTEREST_RAPIDAPI_KEY=
ALIBABA_1688_RAPIDAPI_KEY=
ALIEXPRESS_RAPIDAPI_KEY=
SHOPEE_PARTNER_ID=
SHOPEE_API_KEY=
TOKOPEDIA_CLIENT_ID=
TOKOPEDIA_CLIENT_SECRET=
LAZADA_APP_KEY=
LAZADA_APP_SECRET=

# ── Scoring thresholds ──────────────────────────────────────
TREND_SCORE_THRESHOLD=85
MARGIN_THRESHOLD_PCT=25
COMPETITION_THRESHOLD=60
TOP_N_OPPORTUNITIES=20

# ── Job schedule ────────────────────────────────────────────
SOCIAL_SCAN_INTERVAL_MS=7200000
MARKETPLACE_VALIDATION_INTERVAL_MS=21600000
SUPPLIER_ANALYSIS_INTERVAL_MS=43200000
DAILY_TOP20_CRON=0 6 * * *

LOG_LEVEL=info
